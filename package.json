{
  "name": "broma16-assistant",
  "version": "1.9.0",
  "description": "Broma 16 Assistant — персональный AI-агент для музыкальной дистрибуции, релизов и поддержки Broma 16",
  "main": "dist-electron/main.js",
  "author": "Music 959",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:main": "node scripts/build-main.mjs",
    "build:web": "vite build",
    "build": "node scripts/build-main.mjs && vite build",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "seed:faq": "node scripts/seed-faq.mjs",
    "smoke": "node scripts/smoke.mjs",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "exceljs": "^4.4.0",
    "imapflow": "^2.10.2",
    "mailparser": "^3.14.2",
    "mammoth": "^1.13.0",
    "marked": "^18.1.3",
    "nodemailer": "^10.3.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "unpdf": "^2.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@types/dompurify": "^3.2.0",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  }
}
